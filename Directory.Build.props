<Project>
  <PropertyGroup>
    <!-- NSmithy runtime and codegen version. scripts/nsaws.py reads this too; pass
         -p:NSmithyVersion=0.0.0-SNAPSHOT with NSmithyLocalFeed to build against a local checkout. -->
    <NSmithyVersion Condition="'$(NSmithyVersion)' == ''">0.15.0</NSmithyVersion>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestoreAdditionalProjectSources Condition="'$(NSmithyLocalFeed)' != ''">$(NSmithyLocalFeed)</RestoreAdditionalProjectSources>
    <!-- Keep local-feed restores out of the global cache so 0.0.0-SNAPSHOT is never stale. -->
    <RestorePackagesPath Condition="'$(NSmithyLocalFeed)' != ''">$(MSBuildThisFileDirectory).sweep/packages</RestorePackagesPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
